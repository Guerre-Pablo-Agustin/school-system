// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  telefono  String?
  direccion String?
  rol       Rol      @default(DOCENTE)
  clases    Clase[]  @relation("DocenteClases")
  notas     Nota[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Estudiante {
  id            String            @id @default(uuid())
  nombre        String
  apellido      String
  dni           String?           @unique
  telefono      String?
  direccion     String?
  grado         Int
  seccion       String
  inscripciones ClaseEstudiante[]
  notas         Nota[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("estudiantes")
}

model Nota {
  id           String     @id @default(uuid())
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  estudianteId String
  materia      Materia    @relation(fields: [materiaId], references: [id])
  materiaId    String
  clase        Clase?     @relation(fields: [claseId], references: [id])
  claseId      String?
  bimestre     Int // 1 a 4
  valor        Float // Renombrado de 'nota' para evitar confusión
  docente      User       @relation(fields: [docenteId], references: [id])
  docenteId    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([estudianteId, materiaId, bimestre, claseId])
  @@map("notas")
}

model Materia {
  id        String   @id @default(uuid())
  nombre    String
  ciclo     Ciclo
  grado     Int
  codigo    String   @unique
  clases    Clase[]
  notas     Nota[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("materias")
}

model Clase {
  id          String            @id @default(uuid())
  docente     User              @relation("DocenteClases", fields: [docenteId], references: [id])
  docenteId   String
  materia     Materia           @relation(fields: [materiaId], references: [id])
  materiaId   String
  anioLectivo Int
  estudiantes ClaseEstudiante[]
  notas       Nota[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([docenteId, materiaId, anioLectivo])
  @@map("clases")
}

// Tabla intermedia para relación muchos-a-muchos
model ClaseEstudiante {
  id           String     @id @default(uuid())
  clase        Clase      @relation(fields: [claseId], references: [id])
  claseId      String
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id])
  estudianteId String
  createdAt    DateTime   @default(now())

  @@unique([claseId, estudianteId])
  @@map("clase_estudiante")
}

model Ponderacion {
  id          String   @id @default(uuid())
  ciclo       Ciclo    @unique
  formula     String // Ej: "0.3,0.3,0.2,0.2"
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ponderaciones")
}

enum Rol {
  ADMIN
  DOCENTE
  SUPERADMIN
}

enum Ciclo {
  PRIMARIA
  SECUNDARIA
}
